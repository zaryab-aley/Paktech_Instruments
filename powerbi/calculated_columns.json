    "TableName": "dim_dates",
    "ColumnName": "Year_Month",
    "Expression": "FORMAT(dim_dates[full_date], \"yyyy-MM\")"
  },
  {
    "TableName": "fact_invoices",
    "ColumnName": "Days Overdue",
    "Expression": "\nVAR DueDate = fact_invoices[due_date]\nRETURN\n    IF(\n        ISBLANK(DueDate),\n        BLANK(),\n        MAX(0, DATEDIFF(DueDate, TODAY(), DAY))\n    )"
  },
  {
    "TableName": "fact_invoices",
    "ColumnName": "Ageing Bucket",
    "Expression": "\nSWITCH(\n    TRUE(),\n    ISBLANK(fact_invoices[due_date]), \"Unknown due date\",\n    fact_invoices[Days Overdue] = 0, \"Not overdue\",\n    fact_invoices[Days Overdue] <= 30, \"1–30 days\",\n    fact_invoices[Days Overdue] <= 60, \"31–60 days\",\n    fact_invoices[Days Overdue] <= 90, \"61–90 days\",\n    \"91+ days\"\n)"
  },
