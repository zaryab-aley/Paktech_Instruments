    "TableName": "fact_invoices",
    "ColumnName": "Fully Paid Date",
    "Expression": "\nVAR InvoiceAmount = fact_invoices[gross_amount_pkr]\nVAR Payments = RELATEDTABLE(fact_payments)\nVAR PaymentDates =\n    DISTINCT(\n        SELECTCOLUMNS(\n            Payments,\n            \"PaidDate\", fact_payments[payment_date]\n        )\n    )\nRETURN\n    MINX(\n        FILTER(\n            PaymentDates,\n            VAR CurrentDate = [PaidDate]\n            VAR PaidSoFar =\n                SUMX(\n                    FILTER(\n                        Payments,\n                        fact_payments[payment_date] <= CurrentDate\n                    ),\n                    fact_payments[amount_pkr]\n                )\n            RETURN\n                NOT ISBLANK(CurrentDate)\n                    && InvoiceAmount > 0\n                    && PaidSoFar >= InvoiceAmount\n        ),\n        [PaidDate]\n    )"
  },
  {
    "TableName": "LocalDateTable_55d94e47-c9eb-4c6c-953d-af0a30206439",
    "ColumnName": "Year",
    "Expression": "YEAR([Date])"
  },
  {
    "TableName": "LocalDateTable_55d94e47-c9eb-4c6c-953d-af0a30206439",
    "ColumnName": "MonthNo",
    "Expression": "MONTH([Date])"
  },
  {
    "TableName": "LocalDateTable_55d94e47-c9eb-4c6c-953d-af0a30206439",
    "ColumnName": "Month",
    "Expression": "FORMAT([Date], \"MMMM\")"
  },
  {
    "TableName": "LocalDateTable_55d94e47-c9eb-4c6c-953d-af0a30206439",
    "ColumnName": "QuarterNo",
    "Expression": "INT(([MonthNo] + 2) / 3)"
  },
  {
    "TableName": "LocalDateTable_55d94e47-c9eb-4c6c-953d-af0a30206439",
    "ColumnName": "Quarter",
    "Expression": "\"Qtr \" & [QuarterNo]"
  },
  {
    "TableName": "LocalDateTable_55d94e47-c9eb-4c6c-953d-af0a30206439",
    "ColumnName": "Day",
    "Expression": "DAY([Date])"
  },
  {
    "TableName": "fact_invoices",
    "ColumnName": "Days To Full Payment",
    "Expression": "\nIF(\n    NOT ISBLANK(fact_invoices[Fully Paid Date])\n        && NOT ISBLANK(fact_invoices[invoice_date]),\n    DATEDIFF(\n        fact_invoices[invoice_date],\n        fact_invoices[Fully Paid Date],\n        DAY\n    )\n)"
  },
  {
    "TableName": "fact_service_tickets",
    "ColumnName": "Resolution Days",
    "Expression": "\nVAR OpenedDate = fact_service_tickets[opened_date]\nVAR ClosedDate = fact_service_tickets[closed_date]\nRETURN\n    IF(\n        NOT ISBLANK(OpenedDate)\n            && NOT ISBLANK(ClosedDate)\n            && ClosedDate >= OpenedDate,\n        DATEDIFF(OpenedDate, ClosedDate, DAY),\n        BLANK()\n    )"
  },
